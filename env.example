# Copy to ~/.config/t3-done/env and chmod 600. This is KEY=VALUE data,
# not a shell script; no variable expansion or command substitution occurs.
# With no webhook pair, events stay local and attention events remain queued.
# To deliver, uncomment BOTH settings and replace the placeholders privately.
# WEBHOOK_URL=https://hooks.example.invalid/notify
# WEBHOOK_KEY=REPLACE_ME

# The bundled client uses only read operations and never creates credentials.
T3_URL=http://localhost:3773
# T3_TOKEN_FILE=/absolute/path/to/read-only-token

T3_DONE_POLL_SECONDS=60
T3_DONE_DEBOUNCE_SECONDS=120
T3_DONE_STALL_SECONDS=2700
T3_DONE_T3CTL_TIMEOUT_SECONDS=30
# Optional absolute path overrides:
# T3_DONE_WATCH_FILE=/absolute/path/to/watch.txt
# T3_DONE_STATE_FILE=/absolute/path/to/state.json
# T3_DONE_DAYBOOK_DIR=/absolute/path/to/daybook
# T3_DONE_T3CTL=/absolute/path/to/compatible-read-only-client
